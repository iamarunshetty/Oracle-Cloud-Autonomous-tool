# Oracle Fusion environment configuration
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials

# Oracle Fusion base URL (e.g. https://your-tenant.oraclecloud.com)
FUSION_BASE_URL=https://your-tenant.oraclecloud.com

# Authentication – leave blank; credentials are loaded from the secrets provider
FUSION_USERNAME=
FUSION_PASSWORD=

# Optional: override default SQLite DB path
DB_PATH=fusion_tool.db

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
