# Oracle Fusion environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Oracle Fusion base URL (e.g. https://your-instance.oraclecloud.com)
ORACLE_BASE_URL=https://your-instance.oraclecloud.com

# Authentication: choose one approach
# Option 1 – Basic auth
ORACLE_USERNAME=your_admin_username
ORACLE_PASSWORD=your_admin_password

# Option 2 – Bearer token (takes precedence over basic auth when set)
ORACLE_TOKEN=

# API settings
ORACLE_REQUEST_TIMEOUT=30
ORACLE_RETRY_COUNT=3

# App settings
APP_LOG_LEVEL=INFO
